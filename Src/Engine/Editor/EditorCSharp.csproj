<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET 8.0 for nethost compatibility -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- 允许匹配已安装的任意 8.x 运行时，而非精确匹配 8.0.0 -->
    <RollForward>latestMajor</RollForward>
    <AssemblyName>SEEditorCSharp</AssemblyName>
    <RootNamespace>SE</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Optimize>false</Optimize>
    <!-- Suppress default items; sources will be added explicitly or via globbing -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Intermediate output paths are set by CMake via MSBuild properties (BaseIntermediateOutputPath/BaseOutputPath) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <UseCommonOutputDirectory>true</UseCommonOutputDirectory>
  </PropertyGroup>

  <!-- Runtime config for nethost loading -->
  <PropertyGroup>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" />
  </ItemGroup>

  <!-- Editor-mode compile symbol: set SE_EDITOR=true when building for the editor -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);SE_EDITOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include= "..\Runtime\RuntimeCSharp.csproj" />
  </ItemGroup>

  <!-- C# source files are included explicitly by the Compile glob above. -->
  <!-- Task 2: ScriptingLoadContext.cs - included via Compile glob -->
  <!-- Task 4: NativeInterop.cs       - included via Compile glob -->
  <!-- Task 10: ScriptingObject.cs, Script.cs - included via Compile glob when added -->

</Project>
