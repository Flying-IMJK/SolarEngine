root = true

# Handwritten managed code. Generated bindings have their own section below.
[Src/Engine/{Runtime,Editor}/**/*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
max_line_length = 120
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = block_scoped:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0160.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Types and callable members.
dotnet_naming_rule.types_should_be_pascal.severity = warning
dotnet_naming_rule.types_should_be_pascal.symbols = types
dotnet_naming_rule.types_should_be_pascal.style = pascal
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate

dotnet_naming_rule.interfaces_should_be_i_pascal.severity = warning
dotnet_naming_rule.interfaces_should_be_i_pascal.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_i_pascal.style = i_pascal
dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_rule.type_parameters_should_be_t_pascal.severity = warning
dotnet_naming_rule.type_parameters_should_be_t_pascal.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_be_t_pascal.style = t_pascal
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_rule.members_should_be_pascal.severity = warning
dotnet_naming_rule.members_should_be_pascal.symbols = members
dotnet_naming_rule.members_should_be_pascal.style = pascal
dotnet_naming_symbols.members.applicable_kinds = method, property, event

# The narrower static and constant rules take precedence over instance fields.
dotnet_naming_rule.fields_should_be_pascal.severity = warning
dotnet_naming_rule.fields_should_be_pascal.symbols = fields
dotnet_naming_rule.fields_should_be_pascal.style = pascal
dotnet_naming_symbols.fields.applicable_kinds = field

dotnet_naming_rule.nonpublic_fields_should_be_m_pascal.severity = warning
dotnet_naming_rule.nonpublic_fields_should_be_m_pascal.symbols = nonpublic_fields
dotnet_naming_rule.nonpublic_fields_should_be_m_pascal.style = m_pascal
dotnet_naming_symbols.nonpublic_fields.applicable_kinds = field
dotnet_naming_symbols.nonpublic_fields.applicable_accessibilities = private, protected, private_protected

dotnet_naming_rule.static_fields_should_be_s_pascal.severity = warning
dotnet_naming_rule.static_fields_should_be_s_pascal.symbols = static_fields
dotnet_naming_rule.static_fields_should_be_s_pascal.style = s_pascal
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_rule.nonpublic_static_fields_should_be_s_pascal.severity = warning
dotnet_naming_rule.nonpublic_static_fields_should_be_s_pascal.symbols = nonpublic_static_fields
dotnet_naming_rule.nonpublic_static_fields_should_be_s_pascal.style = s_pascal
dotnet_naming_symbols.nonpublic_static_fields.applicable_kinds = field
dotnet_naming_symbols.nonpublic_static_fields.applicable_accessibilities = private, protected, private_protected
dotnet_naming_symbols.nonpublic_static_fields.required_modifiers = static

# Const is implicitly static; the intersections prevent an s_ prefix on constants.
dotnet_naming_rule.constants_should_be_pascal.severity = warning
dotnet_naming_rule.constants_should_be_pascal.symbols = constants
dotnet_naming_rule.constants_should_be_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.nonpublic_constants_should_be_pascal.severity = warning
dotnet_naming_rule.nonpublic_constants_should_be_pascal.symbols = nonpublic_constants
dotnet_naming_rule.nonpublic_constants_should_be_pascal.style = pascal
dotnet_naming_symbols.nonpublic_constants.applicable_kinds = field
dotnet_naming_symbols.nonpublic_constants.applicable_accessibilities = private, protected, private_protected
dotnet_naming_symbols.nonpublic_constants.required_modifiers = const, static

dotnet_naming_rule.static_readonly_fields_should_be_pascal.severity = warning
dotnet_naming_rule.static_readonly_fields_should_be_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_should_be_pascal.style = pascal
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.nonpublic_static_readonly_fields_should_be_pascal.severity = warning
dotnet_naming_rule.nonpublic_static_readonly_fields_should_be_pascal.symbols = nonpublic_static_readonly_fields
dotnet_naming_rule.nonpublic_static_readonly_fields_should_be_pascal.style = pascal
dotnet_naming_symbols.nonpublic_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.nonpublic_static_readonly_fields.applicable_accessibilities = private, protected, private_protected
dotnet_naming_symbols.nonpublic_static_readonly_fields.required_modifiers = static, readonly

# Parameters and local variables.
dotnet_naming_rule.parameters_should_be_camel.severity = warning
dotnet_naming_rule.parameters_should_be_camel.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel.style = camel
dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_rule.locals_should_be_camel.severity = warning
dotnet_naming_rule.locals_should_be_camel.symbols = locals
dotnet_naming_rule.locals_should_be_camel.style = camel
dotnet_naming_symbols.locals.applicable_kinds = local

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.i_pascal.required_prefix = I
dotnet_naming_style.i_pascal.capitalization = pascal_case
dotnet_naming_style.t_pascal.required_prefix = T
dotnet_naming_style.t_pascal.capitalization = pascal_case
dotnet_naming_style.m_pascal.required_prefix = m_
dotnet_naming_style.m_pascal.capitalization = pascal_case
dotnet_naming_style.s_pascal.required_prefix = s_
dotnet_naming_style.s_pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case

[Src/Engine/**/_Generated/**/*.cs]
generated_code = true

# Documentation comment completion is a Visual Studio preference, not formatting.
[*.{c++,cc,cpp,cppm,cxx,h,h++,hh,hpp,hxx,inl,ipp,ixx,tlh,tli}]
cpp_generate_documentation_comments = xml
